# # PRAQEN Dev Environment Template
# Copy this to .env and fill in your dev Supabase keys
# Then run: node setup-hd-wallet.js

# Dev Supabase
SUPABASE_URL=https://hpkepzxvrumijmdvwaje.supabase.co
SUPABASE_ANON_KEY=your-dev-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

# Dev server
PORT=5000
NODE_ENV=development

# Blockchain Network Configuration
# Bitcoin: 'mainnet' or 'testnet'
HD_NETWORK=mainnet
# Tron / TRC-20 USDT: 'mainnet' or 'testnet' (or 'nile')
# When set to testnet/nile, automatically points to Nile Testnet and the official Nile USDT contract
TRON_NETWORK=mainnet
# Optional TronGrid API key (recommended for higher rate limits)
# TRONGRID_API_KEY=your-trongrid-key
# Optional overrides (defaults are auto-selected based on TRON_NETWORK):
# TRONGRID_URL=https://nile.trongrid.io
# TRON_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
# TRONSCAN_URL=https://nile.tronscan.org

# Blockchain APIs (Add later for real Bitcoin)
# BLOCKCHAIN_COM_API_KEY=your_api_key
# MEMPOOL_API_URL=https://mempool.space/api

# Email Configuration (Add later for real emails)
# SENDGRID_API_KEY=your_sendgrid_key
#ADMIN_EMAIL=admin@praqen.com


# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=your-smtp-from

AFRICASTALKING_USERNAME=your-africatalking-username
AFRICASTALKING_API_KEY=your-africatalking-api-key
AFRICASTALKING_SENDER_ID=your-africatalking-sender-id


# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret


FRONTEND_URL=http://localhost:3000


TWILIO_SID=your-twilio-sid
TWILIO_TOKEN=your-twilio-token
TWILIO_VERIFY_SID=your-twilio-verify-sid
TWILIO_PHONE=your-twilio-phone

TELEGRAM_BOT_TOKEN=your-telegram-bot-token

MISTRAL_API_KEY=your-mistral-api-key

ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

MISTRAL_API_KEY=your-mistral-api-key